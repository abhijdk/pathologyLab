CREATE TABLE booking_test (
    booking_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    patient_id BIGINT NOT NULL,
    doctor_id INT NOT NULL,
    booking_category JSON NOT NULL,
    booking_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    total_amount DECIMAL(10,2) NOT NULL,
    advance_amount DECIMAL(10,2) DEFAULT 0.00,
    remaining_amount DECIMAL(10,2),
    payment_status ENUM('Pending','Partial','Paid','Refunded') DEFAULT 'Pending',
    report_status ENUM('Awaiting','In Progress','Generated','Delivered') DEFAULT 'Awaiting',

    FOREIGN KEY (patient_id) REFERENCES patient(patient_id),
    FOREIGN KEY (doctor_id) REFERENCES doctor(doctor_id)
);


CREATE TABLE test_report (
    report_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    booking_id BIGINT NOT NULL,
    category_id BIGINT NOT NULL,
    param_id BIGINT NOT NULL,
    result_value VARCHAR(255),
    captured_at DATETIME DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (booking_id) REFERENCES booking_test(booking_id) ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES test_category(category_id)
);


