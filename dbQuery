CREATE TABLE test_category (
    category_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    test_id BIGINT NOT NULL,
    category_name VARCHAR(255),
    display_order INT,
    is_active BIT(1),
    amount DOUBLE,
    FOREIGN KEY (test_id) REFERENCES test_master(test_id)
);


