CREATE TABLE test_parameter (
    param_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    category_id BIGINT NOT NULL,
    param_name VARCHAR(255),
    unit VARCHAR(255),
    ref_male_min VARCHAR(255),
    ref_male_max VARCHAR(255),
    ref_female_min VARCHAR(255),
    ref_female_max VARCHAR(255),
    display_order INT,
    is_active BIT(1),
    FOREIGN KEY (category_id) REFERENCES test_category(category_id)
);

